{
  "expo": {
    "name": "Lyric Library",
    "slug": "lyric-library",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.furolabs.lyriclibrary"
    },
    "android": {
      "package": "com.furolabs.lyriclibrary"
    },
    "plugins": [
      "expo-font",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Lyric Library to use your photos as an app background."
        }
      ]
    ]
  }
}
